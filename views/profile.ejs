<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Settings - Agro-Haat AI</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-green: #2e7d32;
            --primary-emerald: #10b981;
            --dark-glass: rgba(255, 255, 255, 0.85);
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            --gradient-bg: linear-gradient(135deg, #e8f5e9 0%, #f4f7f6 50%, #e0f2f1 100%);
        }

        body {
            background: var(--gradient-bg);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            color: #1f2937;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            box-shadow: 0 15px 35px rgba(46, 125, 50, 0.12);
        }

        /* Avatar Container & Glow */
        .avatar-wrapper {
            position: relative;
            display: inline-block;
        }

        .avatar-img {
            width: 130px;
            height: 130px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid #ffffff;
            box-shadow: 0 0 20px rgba(46, 125, 50, 0.3);
            transition: transform 0.3s ease;
        }

        .avatar-wrapper:hover .avatar-img {
            transform: scale(1.03);
        }

        .camera-badge {
            position: absolute;
            bottom: 5px;
            right: 5px;
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid #ffffff;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            transition: all 0.2s ease;
        }

        .camera-badge:hover {
            transform: scale(1.15);
            background: #047857;
        }

        /* Form Controls */
        .form-control, .form-select {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 12px 18px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background-color: #ffffff;
        }

        .form-control:focus, .form-select:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
            background-color: #ffffff;
        }

        .form-control[disabled], .form-control[readonly] {
            background-color: #f3f4f6;
            color: #6b7280;
            border-color: #e5e7eb;
        }

        .form-label {
            font-weight: 600;
            color: #374151;
            font-size: 0.88rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        /* Premium Buttons */
        .btn-green-gradient {
            background: linear-gradient(135deg, #2e7d32 0%, #10b981 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 30px;
            font-weight: 600;
            letter-spacing: 0.3px;
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.3);
            transition: all 0.3s ease;
        }

        .btn-green-gradient:hover {
            background: linear-gradient(135deg, #1b5e20 0%, #059669 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(16, 185, 129, 0.4);
            color: white;
        }

        .badge-role {
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            color: #065f46;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 20px;
            border: 1px solid #a7f3d0;
            font-size: 0.85rem;
        }

        .stat-box {
            background: rgba(243, 244, 246, 0.7);
            border-radius: 14px;
            padding: 12px;
            text-align: center;
            border: 1px solid #f3f4f6;
        }

        .nav-back-btn {
            background: #ffffff;
            color: #374151;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 8px 20px;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .nav-back-btn:hover {
            background: #f9fafb;
            color: #2e7d32;
            border-color: #2e7d32;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <div class="container pt-4 pb-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a href="<%= (user && user.role === 'Farmer') ? '/farmer/dashboard' : '/customer/dashboard' %>" class="nav-back-btn shadow-sm">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
            <div>
                <a href="/change_password" class="btn btn-outline-success rounded-pill px-4 btn-sm fw-bold">
                    <i class="fas fa-key me-2"></i>Change Password
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <div class="container my-4 pb-5">
        
        <!-- Alerts -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row g-4">
            
            <!-- Left Side: Profile Card & Photo Upload -->
            <div class="col-lg-4">
                <div class="glass-card p-4 text-center">
                    
                    <!-- Avatar with Camera Badge -->
                    <div class="avatar-wrapper mb-3">
                        <% const userImg = (user && user.image) ? user.image : 'default.jpg'; %>
                        <% if (userImg && userImg !== 'default.jpg') { %>
                            <img id="avatarPreview" src="/public/uploads/profile_pictures/<%= userImg %>" class="avatar-img" alt="Profile Picture">
                        <% } else { %>
                            <div id="avatarInitials" class="avatar-img bg-success d-inline-flex align-items-center justify-content-center">
                                <span class="text-white fw-bold" style="font-size: 42px;">
                                    <%= (user && user.fullname) ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                                </span>
                            </div>
                        <% } %>

                        <label for="profileImageInput" class="camera-badge" title="Click to upload profile photo">
                            <i class="fas fa-camera"></i>
                        </label>
                    </div>

                    <!-- User Name & Role -->
                    <h4 class="fw-bold mb-1 text-dark"><%= (user && user.fullname) ? user.fullname : 'Agro-Haat User' %></h4>
                    <p class="text-muted small mb-2"><i class="fas fa-envelope me-1 text-secondary"></i><%= (user && user.email) ? user.email : 'user@agrohaat.com' %></p>
                    
                    <div class="mb-3">
                        <span class="badge-role">
                            <i class="fas fa-user-shield me-1"></i><%= (user && user.role) ? user.role : 'Member' %>
                        </span>
                    </div>

                    <% if (user && user.bio) { %>
                        <p class="text-muted small fst-italic px-3 mb-4">"<%= user.bio %>"</p>
                    <% } else { %>
                        <p class="text-muted small fst-italic px-3 mb-4">"Smart Agriculture & Sustainable Farming Community Member"</p>
                    <% } %>

                    <!-- Account Quick Stats -->
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="stat-box">
                                <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem;">Status</small>
                                <span class="fw-bold text-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-box">
                                <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem;">Location</small>
                                <span class="fw-bold text-dark"><%= (user && user.location) ? user.location : 'Not Set' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden Photo Upload Form -->
                    <form id="photoForm" action="/backend/upload_image.php" method="POST" enctype="multipart/form-data">
                        <input type="file" id="profileImageInput" name="profile_image" class="d-none" accept="image/*" onchange="submitPhotoForm()">
                        <button type="submit" id="submitPhotoBtn" class="btn btn-outline-success rounded-pill w-100 btn-sm fw-semibold">
                            <i class="fas fa-cloud-upload-alt me-2"></i>Update Profile Picture
                        </button>
                    </form>
                </div>
            </div>

            <!-- Right Side: Edit Profile Form -->
            <div class="col-lg-8">
                <div class="glass-card p-4 p-md-5">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1 text-success"><i class="fas fa-user-edit me-2"></i>Edit Profile Information</h4>
                            <p class="text-muted small mb-0">Update your account settings and personal location details.</p>
                        </div>
                        <span class="badge bg-light text-muted border rounded-pill px-3 py-2">
                            <i class="fas fa-lock me-1"></i>Secured Account
                        </span>
                    </div>

                    <form method="POST" action="/profile">
                        
                        <div class="row g-3 mb-4">
                            <!-- Full Name (Fixed) -->
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-id-card me-1 text-success"></i> Full Name</label>
                                <input type="text" class="form-control" value="<%= (user && user.fullname) ? user.fullname : '' %>" disabled>
                                <div class="form-text small text-muted"><i class="fas fa-info-circle me-1"></i>Full name is locked. Contact support for changes.</div>
                            </div>

                            <!-- Email Address (Fixed) -->
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-envelope me-1 text-success"></i> Email Address</label>
                                <input type="email" class="form-control" value="<%= (user && user.email) ? user.email : '' %>" disabled>
                                <div class="form-text small text-muted"><i class="fas fa-lock me-1"></i>Verified email linked to account.</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Location / City -->
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-map-marker-alt me-1 text-success"></i> Farm / City Location</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 rounded-start-4"><i class="fas fa-location-dot text-danger"></i></span>
                                    <input type="text" name="location" class="form-control border-start-0 rounded-end-4"
                                           placeholder="e.g. Nagpur, Maharashtra"
                                           value="<%= (user && user.location) ? user.location : '' %>">
                                </div>
                            </div>

                            <!-- Farmer Speciality -->
                            <% if (user && user.role === 'Farmer') { %>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-seedling me-1 text-success"></i> Farming Speciality</label>
                                <select name="speciality" class="form-select">
                                    <option value="">Select Farming Category</option>
                                    <%
                                    const specialities = ['Organic Farmer', 'Vegetable Specialist', 'Fruit Grower', 'Grain Farmer', 'Dairy Farmer', 'Poultry Farmer', 'Mixed Farming'];
                                    specialities.forEach(sp => {
                                        const selected = (user && user.speciality === sp) ? 'selected' : '';
                                    %>
                                        <option value="<%= sp %>" <%= selected %>><%= sp %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <% } else { %>
                                <input type="hidden" name="speciality" value="<%= (user && user.speciality) ? user.speciality : '' %>">
                            <% } %>
                        </div>

                        <!-- Bio / Description -->
                        <div class="mb-4">
                            <label class="form-label"><i class="fas fa-pen me-1 text-success"></i> Bio / Farm Description</label>
                            <textarea name="bio" class="form-control" rows="4"
                                      placeholder="Share a brief overview of your farming techniques, experience, or produce..."><%= (user && user.bio) ? user.bio : '' %></textarea>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <button type="reset" class="btn btn-light rounded-pill px-4">
                                <i class="fas fa-undo me-2"></i>Reset
                            </button>
                            <button type="submit" class="btn btn-green-gradient">
                                <i class="fas fa-check-circle me-2"></i>Save Profile Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- JavaScript for Live Photo Upload Preview -->
    <script>
    function submitPhotoForm() {
        const fileInput = document.getElementById('profileImageInput');
        if (fileInput.files && fileInput.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const avatarImg = document.getElementById('avatarPreview');
                const avatarInitials = document.getElementById('avatarInitials');
                if (avatarImg) {
                    avatarImg.src = e.target.result;
                } else if (avatarInitials) {
                    avatarInitials.outerHTML = `<img id="avatarPreview" src="${e.target.result}" class="avatar-img" alt="Profile Picture">`;
                }
            };
            reader.readAsDataURL(fileInput.files[0]);
            
            // Auto submit form on photo select
            document.getElementById('photoForm').submit();
        }
    }
    </script>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
