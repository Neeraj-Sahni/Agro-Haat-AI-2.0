<%- include('../partials/header', { page_title: 'Customer Dashboard' }) %>
<%- include('../partials/navbar_customer') %>

<div class="container mt-5">
    <div class="row align-items-center mb-5 animate-fade-in-up">
        <div class="col-md-7">
            <h1 class="display-4 text-primary mb-2" style="color: var(--primary-blue) !important;">Hello, <%= user ? user.fullname : 'Customer' %>! 🛒</h1>
            <p class="text-muted fs-5">Fresh organic vegetables delivered straight from the farm to your door. Support local farmers today.</p>
        </div>
        <div class="col-md-5">
            <form action="/customer/browse_products" method="GET" class="glass-card p-2 d-flex">
                <input type="text" name="search" class="form-control border-0 bg-transparent" placeholder="Search vegetables...">
                <button class="btn btn-premium btn-premium-blue ms-2" type="submit"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-5 animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="col-md-4">
            <div class="glass-card stat-card border-bottom border-4 border-warning">
                <div class="stat-value text-warning"><%= total_products || 0 %></div>
                <div class="stat-label">Available Items</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-card border-bottom border-4 border-info">
                <div class="stat-value text-info"><%= total_orders || 0 %></div>
                <div class="stat-label">Your Orders</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-card border-bottom border-4 border-success">
                <div class="stat-value text-success">100%</div>
                <div class="stat-label">Organic Guarantee</div>
            </div>
        </div>
    </div>

    <div class="row g-4 animate-fade-in-up" style="animation-delay: 0.2s;">
        <%
        const features = [
            { title: 'Browse Products', icon: 'fa-carrot', color: 'warning', desc: 'Discover fresh vegetables and organic produce directly from local farmers.', link: '/customer/browse_products', btn: 'Shop Now' },
            { title: 'Delivery Plans', icon: 'fa-calendar-alt', color: 'success', desc: 'Subscribe to weekly fresh baskets delivered to your doorstep.', link: '/customer/delivery_plans', btn: 'View Plans' },
            { title: 'Track Orders', icon: 'fa-truck', color: 'info', desc: 'Keep an eye on your recent purchases and delivery status.', link: '/customer/my_orders', btn: 'My Orders' },
            { title: 'Farmer Profiles', icon: 'fa-users', color: 'secondary', desc: 'Meet the farmers growing your food. View their practices and ratings.', link: '/customer/farmer_profiles', btn: 'Meet Farmers' },
            { title: 'Purchase History', icon: 'fa-history', color: 'primary', desc: 'Easily reorder your favorite products from past purchases.', link: '/customer/my_orders', btn: 'View History' },
            { title: 'Offers & Deals', icon: 'fa-tags', color: 'danger', desc: 'Check out bulk discounts and seasonal offers on fresh produce.', link: '/customer/offers', btn: 'Claim Offers' },
        ];
        %>
        <% features.forEach(f => { %>
            <div class="col-lg-4 col-md-6">
                <div class="glass-card h-100 p-4 d-flex flex-column text-center">
                    <div class="mb-3">
                        <i class="fas <%= f.icon %> fa-3x text-<%= f.color %>"></i>
                    </div>
                    <h5 class="fw-bold mb-2"><%= f.title %></h5>
                    <p class="text-muted small flex-grow-1"><%= f.desc %></p>
                    <a href="<%= f.link %>" class="btn btn-outline-<%= f.color %> btn-sm rounded-pill mt-3 px-4"><%= f.btn %></a>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('../partials/footer') %>
