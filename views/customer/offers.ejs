<%- include('../partials/header', { page_title: 'Special Offers & FAQs' }) %>
<%- include('../partials/navbar_customer') %>

<div class="container mt-5 mb-5">
    <div class="row g-5">
        <div class="col-md-7 animate-fade-in-up">
            <h2 class="fw-bold mb-4" style="color: var(--primary-blue) !important;">Exclusive Deals 🎁</h2>
            
            <div class="row g-4">
                <div class="col-12">
                    <div class="glass-card p-4 bg-primary text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1a5276 0%, #2980b9 100%) !important;">
                        <div class="position-relative z-1">
                            <h4 class="fw-bold mb-1">20% Monsoon Discount</h4>
                            <p class="mb-3 small text-light">Valid on all leafy vegetables till end of June.</p>
                            <span class="badge bg-white text-primary px-4 py-2 fw-bold" style="letter-spacing: 2px;">CODE: RAINY20</span>
                        </div>
                        <i class="fas fa-cloud-rain position-absolute bottom-0 end-0 m-3 opacity-25" style="font-size: 5rem; transform: rotate(-15deg);"></i>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="glass-card p-4 bg-success text-white">
                        <h5 class="fw-bold mb-1">Bulk Saver</h5>
                        <p class="small mb-0 opacity-75">Order > 10kg potatoes/onions and save 10% automatically.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="glass-card p-4 bg-warning text-dark">
                        <h5 class="fw-bold mb-1">Refer & Earn</h5>
                        <p class="small mb-0 opacity-75">Invite a friend to FarmToHome and get ₹100 credit.</p>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h4 class="fw-bold mb-4">Frequently Asked Questions</h4>
                <div class="accordion accordion-flush glass-card overflow-hidden" id="faqAccordion">
                    <div class="accordion-item bg-transparent">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                How fresh are the vegetables?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse p-3 text-muted small">
                            Most orders are harvested within 12-24 hours of delivery. We ensure zero cold storage time to maintain nutrients and flavor.
                        </div>
                    </div>
                    <div class="accordion-item bg-transparent">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Can I cancel my subscription?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse p-3 text-muted small">
                            Yes, you can cancel or pause your delivery plans anytime from your profile settings with no extra charges.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5 animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3">Newsletter</h5>
                <p class="text-muted small">Get weekly farm updates and exclusive seasonal coupons.</p>
                <form class="d-flex">
                    <input type="email" class="form-control rounded-pill border-0 bg-light me-2" placeholder="Email address">
                    <button class="btn btn-premium btn-premium-blue rounded-pill px-4">Join</button>
                </form>
            </div>

            <div class="glass-card p-4 border-start border-4 border-info">
                <h5 class="fw-bold mb-2">Need Help?</h5>
                <p class="text-muted small mb-3">Can't find an answer? Contact our 24/7 support team.</p>
                <a href="tel:+919876543210" class="btn btn-outline-info w-100 rounded-pill fw-bold"><i class="fas fa-phone-alt me-2"></i>+91 98765-43210</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
