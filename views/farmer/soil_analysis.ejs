<%- include('../partials/header', { page_title: 'Soil Health Analysis' }) %>
<%- include('../partials/navbar_farmer') %>

<div class="container mt-5 mb-5">
    <div class="row g-5">
        <div class="col-md-5 animate-fade-in-up">
            <h2 class="text-warning fw-bold mb-4">Soil Intel 🧪🔬</h2>
            <p class="text-muted mb-4">Enter your soil test parameters (N-P-K levels and pH) to receive a detailed 8-point health report and customized fertilizer recommendations in English.</p>
            
            <div class="glass-card p-4">
                <form id="soilForm">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Nitrogen (N)</label>
                            <input type="number" id="n_level" class="form-control rounded-pill" placeholder="e.g. 140" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Phosphorus (P)</label>
                            <input type="number" id="p_level" class="form-control rounded-pill" placeholder="e.g. 50" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Potassium (K)</label>
                            <input type="number" id="k_level" class="form-control rounded-pill" placeholder="e.g. 200" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Soil pH</label>
                            <input type="number" step="0.1" id="ph_level" class="form-control rounded-pill" placeholder="e.g. 6.5" required>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" id="analyzeSoil" class="btn btn-premium btn-premium-green w-100 py-3">Run 8-Point Soil Check</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-7">
            <div id="resultCard" class="glass-card p-4 h-100 d-none animate-fade-in-up">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold text-warning mb-0"><i class="fas fa-flask me-2"></i>Structured Soil Health Report</h5>
                    <span class="badge bg-warning text-dark rounded-pill px-3">Live Groq AI</span>
                </div>
                
                <div class="text-center mb-3 p-3 bg-light rounded-4">
                    <h3 id="soilStatus" class="fw-bold text-dark mb-0">--</h3>
                </div>

                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="bg-white rounded-3 p-2 border shadow-sm">
                            <small class="d-block text-muted">N (Nitrogen)</small>
                            <span id="n_res" class="fw-bold text-primary">--</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-white rounded-3 p-2 border shadow-sm">
                            <small class="d-block text-muted">P (Phosphorus)</small>
                            <span id="p_res" class="fw-bold text-success">--</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-white rounded-3 p-2 border shadow-sm">
                            <small class="d-block text-muted">K (Potassium)</small>
                            <span id="k_res" class="fw-bold text-warning">--</span>
                        </div>
                    </div>
                </div>

                <!-- 8-Point Structured Breakdown in English -->
                <div class="row g-2 small">
                    <div class="col-12">
                        <div class="p-2 bg-white rounded-3 border">
                            <strong class="text-warning">❓ Why:</strong> <span id="soilWhy" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-danger">⚡ Severity:</strong> <span id="soilSeverity" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-primary">💊 Fertilizer:</strong> <span id="soilFertilizer" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-info">⚖️ Quantity:</strong> <span id="soilQuantity" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-secondary">🚜 How to Apply:</strong> <span id="soilHow" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-danger">⏰ When to Apply:</strong> <span id="soilWhen" class="text-muted">--</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 bg-white rounded-3 border h-100">
                            <strong class="text-success">🛡️ Prevention:</strong> <span id="soilPrevention" class="text-muted">--</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-outline-warning text-dark btn-sm w-100 rounded-pill" onclick="window.print()"><i class="fas fa-print me-2"></i>Download Soil Report</button>
                </div>
            </div>
            
            <div id="placeholderResult" class="glass-card p-5 h-100 d-flex flex-column align-items-center justify-content-center border-dashed border-2 text-muted">
                <i class="fas fa-microscope fa-3x mb-3 text-warning opacity-50"></i>
                <p class="mb-0 text-center small">Analyze N-P-K & pH levels to get complete 8-point AI fertilizer & soil health guidance in English.</p>
            </div>
        </div>
    </div>

    <div class="mt-5 animate-fade-in-up" style="animation-delay: 0.3s;">
        <h5 class="fw-bold mb-4">Soil Health History</h5>
        <div class="row g-3">
            <% if (history && history.length > 0) { %>
                <% history.forEach(row => { %>
                    <div class="col-md-4">
                        <div class="glass-card p-3 border-start border-4 border-warning">
                            <h6 class="fw-bold mb-1"><%= row.recommended_crop %></h6>
                            <small class="text-muted d-block mb-2">Input: <%= row.soil_type %></small>
                            <small class="text-muted"><%= new Date(row.created_at).toLocaleDateString() %></small>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center p-4">
                    <p class="text-muted italic">No previous records found.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
document.getElementById('analyzeSoil').addEventListener('click', async function() {
    const n  = document.getElementById('n_level').value;
    const p  = document.getElementById('p_level').value;
    const k  = document.getElementById('k_level').value;
    const ph = document.getElementById('ph_level').value;

    if (!n || !p || !k || !ph) { alert("Please fill all fields"); return; }

    const btn = document.getElementById('analyzeSoil');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>AI Analyzing Soil...';

    document.getElementById('placeholderResult').classList.add('d-none');
    document.getElementById('resultCard').classList.remove('d-none');
    document.getElementById('soilStatus').innerText = 'AI Analyzing...';
    document.getElementById('n_res').innerText = n;
    document.getElementById('p_res').innerText = p;
    document.getElementById('k_res').innerText = k;

    try {
        const response = await fetch('/actions/soil_ai_action.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `n=${n}&p=${p}&k=${k}&ph=${ph}`
        });

        const data = await response.json();

        if (data.success) {
            document.getElementById('soilStatus').innerText     = data.status;
            document.getElementById('soilWhy').innerText        = data.why || data.advice || '--';
            document.getElementById('soilSeverity').innerText   = data.severity || '--';
            document.getElementById('soilFertilizer').innerText = data.fertilizer || '--';
            document.getElementById('soilQuantity').innerText   = data.quantity || '--';
            document.getElementById('soilHow').innerText        = data.how || '--';
            document.getElementById('soilWhen').innerText       = data.when || '--';
            document.getElementById('soilPrevention').innerText = data.prevention || '--';
            document.getElementById('n_res').innerText          = data.n;
            document.getElementById('p_res').innerText          = data.p;
            document.getElementById('k_res').innerText          = data.k;
        } else {
            document.getElementById('soilStatus').innerText = 'Error!';
        }
    } catch(e) {
        document.getElementById('soilStatus').innerText = 'Server Connection Error!';
    }

    btn.disabled = false;
    btn.innerHTML = 'Run 8-Point Soil Check';
});
</script>

<%- include('../partials/footer') %>
